#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys
import subprocess
from typing import Callable, Optional, Tuple

from PyQt5 import QtCore, QtGui, QtWidgets

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSPresetProfile, qos_profile_sensor_datas

from sensor_msgs.msg import Image
from trajectory_msgs.msg import JointTrajectory

# Ruta al script que lanza Gazebo + mundo UR5 (ajusta si es necesario)
GAZEBO_SCRIPT = "/home/laboratorio/TFM/agarre_ros2_ws/scripts/run_ur5_world.sh"

# Tópicos por defecto
CAM1_TOPIC_DEFAULT = "/camera/color/image_raw"
CAM2_TOPIC_DEFAULT = "/camera_overhead/image"
TRAJ_TOPIC_DEFAULT = "/joint_trajectory_controller/joint_trajectory"


def image_msg_to_qimage(msg: Image) -> Optional[QtGui.QImage]:
    """
    Convierte sensor_msgs/Image (rgb8 o bgr8) a QImage.
    Si el encoding no es soportado, devuelve None.
    """
    if msg.encoding not in ("rgb8", "bgr8"):
        return None

    # bytes por fila (step ya viene en bytes)
    fmt = QtGui.QImage.Format_RGB888
    try:
        img = QtGui.QImage(
            bytes(msg.data),
            msg.width,
            msg.height,
            msg.step,
            fmt,
        )
    except Exception:
        return None

    if msg.encoding == "bgr8":
        img = img.rgbSwapped()

    if img.isNull():
        return None

    return img


class RosBackend(Node):
    """
    Nodo ROS 2 para el panel UR5.
    Hace:
      - Suscripción a dos cámaras con QoS de sensor.
      - Timer para comprobar estado de la simulación.
      - Stubs para publicar trayectorias / lanzar experimentos.
    """

    def __init__(
        self,
        camera1_cb: Callable[[Image], None],
        camera2_cb: Callable[[Image], None],
        status_cb: Callable[[bool, bool, bool, bool], None],
        log_cb: Callable[[str], None],
    ) -> None:
        super().__init__("ur5_qt_panel")

        self._camera1_cb = camera1_cb
        self._camera2_cb = camera2_cb
        self._status_cb = status_cb
        self._log_cb = log_cb

        # QoS de sensor
        self._image_qos = QoSPresetProfiles.SENSOR_DATA.value

        # Suscripciones a cámaras
        self._cam1_topic = CAM1_TOPIC_DEFAULT
        self._cam2_topic = CAM2_TOPIC_DEFAULT

        self._sub_cam1 = self.create_subscription(
            Image,
            self._cam1_topic,
            self._camera1_callback,
            qos_profile=self._image_qos,
        )

        self._sub_cam2 = self.create_subscription(
            Image,
            self._cam2_topic,
            self._camera2_callback,
            qos_profile=self._image_qos,
        )

        # Publicador de trayectorias (stub)
        self._traj_pub = self.create_publisher(
            JointTrajectory,
            TRAJ_TOPIC_DEFAULT,
            10,
        )

        # Timer de comprobación de simulación
        self._status_timer = self.create_timer(3.0, self._check_sim_status)

        self._log_cb("RosBackend inicializado.")

    # ------------------------------------------------------------------
    # Callbacks ROS
    # ------------------------------------------------------------------
    def _camera1_callback(self, msg: Image) -> None:
        # Log ligero para debug (puedes comentar si molesta)
        self.get_logger().debug(
            f"[CAM1] frame recibido: {msg.header.stamp.sec}.{msg.header.stamp.nanosec}"
        )
        self._camera1_cb(msg)

    def _camera2_callback(self, msg: Image) -> None:
        self.get_logger().debug(
            f"[CAM2] frame recibido: {msg.header.stamp.sec}.{msg.header.stamp.nanosec}"
        )
        self._camera2_cb(msg)

    def _check_sim_status(self) -> None:
        """
        Comprueba periódicamente:
          - Si hay clock (/clock)
          - Si hay cámaras
          - Si hay tópico de trayectoria
        """
        topics = dict(self.get_topic_names_and_types())

        has_clock = "/clock" in topics

        has_cam1 = CAM1_TOPIC_DEFAULT in topics
        has_cam2 = CAM2_TOPIC_DEFAULT in topics
        has_camera = has_cam1 or has_cam2

        has_traj = TRAJ_TOPIC_DEFAULT in topics

        sim_ready = has_camera and has_traj

        self._log_cb(
            "========== [STATUS] Comprobación de simulación ==========\n"
            f"  {CAM1_TOPIC_DEFAULT} : {topics.get(CAM1_TOPIC_DEFAULT, [])}\n"
            f"  {CAM2_TOPIC_DEFAULT} : {topics.get(CAM2_TOPIC_DEFAULT, [])}\n"
            f"  {TRAJ_TOPIC_DEFAULT} : {topics.get(TRAJ_TOPIC_DEFAULT, [])}\n"
            "=========================================================\n"
            f"[STATUS] has_clock={has_clock}, "
            f"has_camera={has_camera}, has_traj={has_traj}, "
            f"sim_ready={sim_ready}"
        )

        self._status_cb(has_clock, has_camera, has_traj, sim_ready)

    # ------------------------------------------------------------------
    # Acciones de alto nivel (stubs)
    # ------------------------------------------------------------------
    def go_home(self) -> None:
        self._log_cb("[ACCION] Ir a posición HOME (stub).")
        # Aquí podrías construir y publicar un JointTrajectory real.

    def go_grasp_pose(self) -> None:
        self._log_cb("[ACCION] Ir a posición de AGARRE (stub).")

    def reset_robot(self) -> None:
        self._log_cb("[ACCION] RESET del UR5 (stub).")

    def run_experiment(self, idx: int) -> None:
        self._log_cb(f"[EXP] Lanzar experimento EXP{idx} (stub).")

    # ------------------------------------------------------------------
    # Utilidades para cambiar topics (si se quisieran hacer dinámicos)
    # ------------------------------------------------------------------
    def set_camera_topics(self, cam1: str, cam2: str) -> None:
        if cam1 != self._cam1_topic:
            self._sub_cam1.destroy()
            self._cam1_topic = cam1
            self._sub_cam1 = self.create_subscription(
                Image,
                self._cam1_topic,
                self._camera1_callback,
                qos_profile=self._image_qos,
            )
            self._log_cb(f"[CFG] Cámara 1 suscrita a: {self._cam1_topic}")

        if cam2 != self._cam2_topic:
            self._sub_cam2.destroy()
            self._cam2_topic = cam2
            self._sub_cam2 = self.create_subscription(
                Image,
                self._cam2_topic,
                self._camera2_callback,
                qos_profile=self._image_qos,
            )
            self._log_cb(f"[CFG] Cámara 2 suscrita a: {self._cam2_topic}")


class CameraWidget(QtWidgets.QLabel):
    """
    QLabel para mostrar la imagen de cámara.
    """

    def __init__(self, parent=None) -> None:
        super().__init__(parent)
        self.setAlignment(QtCore.Qt.AlignCenter)
        self.setText("Esperando imagen...")
        self.setMinimumSize(320, 240)
        self.setStyleSheet("background-color: #111111; color: #CCCCCC;")

    def show_image(self, qimage: QtGui.QImage) -> None:
        if qimage is None or qimage.isNull():
            return
        pixmap = QtGui.QPixmap.fromImage(qimage)
        pixmap = pixmap.scaled(
            self.size(), QtCore.Qt.KeepAspectRatio, QtCore.Qt.SmoothTransformation
        )
        self.setPixmap(pixmap)


class MainWindow(QtWidgets.QMainWindow):
    """
    Ventana principal del Panel UR5 – Cámaras + Control + Experimentos.
    """

    def __init__(self) -> None:
        super().__init__()

        self.setWindowTitle("Panel UR5 – Cámaras + Control + Experimentos")
        self.resize(1000, 700)

        self.backend: Optional[RosBackend] = None
        self.ros_timer: Optional[QtCore.QTimer] = None
        self._gazebo_process: Optional[subprocess.Popen] = None

        self._build_ui()
        self._init_ros()

    # ------------------------------------------------------------------
    # Construcción de interfaz
    # ------------------------------------------------------------------
    def _build_ui(self) -> None:
        central = QtWidgets.QWidget(self)
        layout = QtWidgets.QVBoxLayout(central)
        self.setCentralWidget(central)

        # Barra superior con estado y botones generales
        top_bar = QtWidgets.QHBoxLayout()

        self.status_label = QtWidgets.QLabel("GAZEBO / ROS 2: DESCONOCIDO")
        self.status_label.setAlignment(QtCore.Qt.AlignCenter)
        self.status_label.setStyleSheet(
            "background-color: #AAAA00; color: black; font-weight: bold; padding: 4px;"
        )

        btn_start_gazebo = QtWidgets.QPushButton("Iniciar Gazebo")
        btn_start_gazebo.clicked.connect(self._on_start_gazebo_clicked)

        btn_close = QtWidgets.QPushButton("Cerrar panel")
        btn_close.clicked.connect(self._on_close_clicked)

        top_bar.addWidget(self.status_label, stretch=2)
        top_bar.addStretch(1)
        top_bar.addWidget(btn_start_gazebo)
        top_bar.addWidget(btn_close)

        layout.addLayout(top_bar)

        # Zona central: cámaras + control UR5 + experimentos
        main_layout = QtWidgets.QHBoxLayout()
        layout.addLayout(main_layout, stretch=1)

        # --- Columna izquierda: cámaras ---
        cams_layout = QtWidgets.QVBoxLayout()

        # Cámara 1
        cam1_box = QtWidgets.QGroupBox("Cámara 1")
        cam1_layout = QtWidgets.QVBoxLayout(cam1_box)
        self.cam1_combo = QtWidgets.QComboBox()
        self.cam1_combo.addItem(CAM1_TOPIC_DEFAULT)
        self.cam1_widget = CameraWidget()
        cam1_layout.addWidget(self.cam1_combo)
        cam1_layout.addWidget(self.cam1_widget)

        # Cámara 2
        cam2_box = QtWidgets.QGroupBox("Cámara 2")
        cam2_layout = QtWidgets.QVBoxLayout(cam2_box)
        self.cam2_combo = QtWidgets.QComboBox()
        self.cam2_combo.addItem(CAM2_TOPIC_DEFAULT)
        self.cam2_widget = CameraWidget()
        cam2_layout.addWidget(self.cam2_combo)
        cam2_layout.addWidget(self.cam2_widget)

        cams_layout.addWidget(cam1_box)
        cams_layout.addWidget(cam2_box)

        main_layout.addLayout(cams_layout, stretch=2)

        # --- Columna derecha: control UR5 + experimentos ---
        right_layout = QtWidgets.QVBoxLayout()

        # Control UR5
        ctrl_box = QtWidgets.QGroupBox("Control UR5")
        ctrl_layout = QtWidgets.QVBoxLayout(ctrl_box)

        btn_home = QtWidgets.QPushButton("Home")
        btn_home.clicked.connect(self._on_home_clicked)
        btn_grasp = QtWidgets.QPushButton("Posición agarre")
        btn_grasp.clicked.connect(self._on_grasp_clicked)
        btn_reset = QtWidgets.QPushButton("Reset")
        btn_reset.clicked.connect(self._on_reset_clicked)

        ctrl_layout.addWidget(btn_home)
        ctrl_layout.addWidget(btn_grasp)
        ctrl_layout.addWidget(btn_reset)

        # Experimentos
        exp_box = QtWidgets.QGroupBox("Experimentos TFM")
        exp_layout = QtWidgets.QVBoxLayout(exp_box)

        btn_exp1 = QtWidgets.QPushButton("Lanzar EXP1")
        btn_exp1.clicked.connect(lambda: self._on_exp_clicked(1))
        btn_exp2 = QtWidgets.QPushButton("Lanzar EXP2")
        btn_exp2.clicked.connect(lambda: self._on_exp_clicked(2))
        btn_exp3 = QtWidgets.QPushButton("Lanzar EXP3")
        btn_exp3.clicked.connect(lambda: self._on_exp_clicked(3))

        exp_layout.addWidget(btn_exp1)
        exp_layout.addWidget(btn_exp2)
        exp_layout.addWidget(btn_exp3)

        right_layout.addWidget(ctrl_box)
        right_layout.addWidget(exp_box)
        right_layout.addStretch(1)

        main_layout.addLayout(right_layout, stretch=1)

        # Zona inferior: log de texto
        self.log_edit = QtWidgets.QPlainTextEdit()
        self.log_edit.setReadOnly(True)
        self.log_edit.setMaximumBlockCount(1000)
        self.log_edit.setStyleSheet("background-color: #111111; color: #DDDDDD;")
        layout.addWidget(self.log_edit, stretch=0)

        # Cambio de topics desde los combos
        self.cam1_combo.currentTextChanged.connect(self._on_camera_topics_changed)
        self.cam2_combo.currentTextChanged.connect(self._on_camera_topics_changed)

    # ------------------------------------------------------------------
    # Inicialización ROS
    # ------------------------------------------------------------------
    def _init_ros(self) -> None:
        self.backend = RosBackend(
            camera1_cb=self._on_camera1_image,
            camera2_cb=self._on_camera2_image,
            status_cb=self._on_status_update,
            log_cb=self._append_log,
        )

        # Timer Qt que ejecuta spin_once para procesar callbacks ROS
        self.ros_timer = QtCore.QTimer(self)
        self.ros_timer.timeout.connect(self._spin_ros_once)
        self.ros_timer.start(20)  # ms

    def _spin_ros_once(self) -> None:
        if self.backend is None:
            return
        try:
            rclpy.spin_once(self.backend, timeout_sec=0.0)
        except Exception as exc:
            self._append_log(f"[ERROR] spin_once: {exc}")

    # ------------------------------------------------------------------
    # Slots de backend ROS -> Qt
    # ------------------------------------------------------------------
    def _on_camera1_image(self, msg: Image) -> None:
        qimg = image_msg_to_qimage(msg)
        if qimg is not None:
            # Ejecutar en hilo GUI
            QtCore.QMetaObject.invokeMethod(
                self.cam1_widget,
                "show_image",
                QtCore.Qt.QueuedConnection,
                QtCore.Q_ARG(QtGui.QImage, qimg),
            )

    def _on_camera2_image(self, msg: Image) -> None:
        qimg = image_msg_to_qimage(msg)
        if qimg is not None:
            QtCore.QMetaObject.invokeMethod(
                self.cam2_widget,
                "show_image",
                QtCore.Qt.QueuedConnection,
                QtCore.Q_ARG(QtGui.QImage, qimg),
            )

    def _on_status_update(
        self, has_clock: bool, has_camera: bool, has_traj: bool, sim_ready: bool
    ) -> None:
        # Actualizamos la etiqueta de estado
        txt = f"GAZEBO / ROS 2: "
        if sim_ready:
            txt += "ON"
            color = "#008800"
        else:
            if has_camera or has_traj:
                txt += "PARCIAL"
                color = "#AA8800"
            else:
                txt += "OFF"
                color = "#880000"

        self.status_label.setText(txt)
        self.status_label.setStyleSheet(
            f"background-color: {color}; color: white; "
            "font-weight: bold; padding: 4px;"
        )

    # ------------------------------------------------------------------
    # Slots de botones Qt
    # ------------------------------------------------------------------
    def _on_start_gazebo_clicked(self) -> None:
        if self._gazebo_process is not None and self._gazebo_process.poll() is None:
            QtWidgets.QMessageBox.information(
                self,
                "Gazebo",
                "Gazebo ya está en ejecución (según el panel).",
            )
            return

        if not os.path.isfile(GAZEBO_SCRIPT):
            QtWidgets.QMessageBox.warning(
                self,
                "Gazebo",
                f"No se ha encontrado el script:\n{GAZEBO_SCRIPT}",
            )
            return

        self._append_log(f"[GAZEBO] Lanzando script: {GAZEBO_SCRIPT}")
        try:
            self._gazebo_process = subprocess.Popen(
                ["bash", GAZEBO_SCRIPT],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception as exc:
            QtWidgets.QMessageBox.critical(
                self,
                "Gazebo",
                f"Error al lanzar Gazebo:\n{exc}",
            )
            self._append_log(f"[ERROR] Al lanzar Gazebo: {exc}")

    def _on_home_clicked(self) -> None:
        if self.backend:
            self.backend.go_home()

    def _on_grasp_clicked(self) -> None:
        if self.backend:
            self.backend.go_grasp_pose()

    def _on_reset_clicked(self) -> None:
        if self.backend:
            self.backend.reset_robot()

    def _on_exp_clicked(self, idx: int) -> None:
        if self.backend:
            self.backend.run_experiment(idx)

    def _on_camera_topics_changed(self) -> None:
        if self.backend is None:
            return
        cam1 = self.cam1_combo.currentText()
        cam2 = self.cam2_combo.currentText()
        self.backend.set_camera_topics(cam1, cam2)

    def _on_close_clicked(self) -> None:
        """
        Botón 'Cerrar panel': pide confirmación y cierra si aceptas.
        """
        reply = QtWidgets.QMessageBox.question(
            self,
            "Cerrar panel",
            "¿Seguro que quieres cerrar el panel UR5?",
            QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
            QtWidgets.QMessageBox.No,
        )
        if reply == QtWidgets.QMessageBox.Yes:
            self.close()

    # ------------------------------------------------------------------
    # Logging
    # ------------------------------------------------------------------
    def _append_log(self, text: str) -> None:
        self.log_edit.appendPlainText(text)

    # ------------------------------------------------------------------
    # Gestión del cierre
    # ------------------------------------------------------------------
    def closeEvent(self, event: QtGui.QCloseEvent) -> None:
        """
        Cierre de la ventana (icono de cierre o botón 'Cerrar panel').
        También solicita confirmación.
        """
        reply = QtWidgets.QMessageBox.question(
            self,
            "Cerrar panel",
            "¿Seguro que quieres cerrar el panel UR5?",
            QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
            QtWidgets.QMessageBox.No,
        )
        if reply != QtWidgets.QMessageBox.Yes:
            event.ignore()
            return

        # Parar timer ROS
        if self.ros_timer is not None:
            self.ros_timer.stop()
            self.ros_timer = None

        # Matar proceso de Gazebo si lo lanzamos nosotros
        if self._gazebo_process is not None and self._gazebo_process.poll() is None:
            try:
                self._gazebo_process.terminate()
            except Exception:
                pass

        # Destruir nodo ROS
        if self.backend is not None:
            try:
                self.backend.destroy_node()
            except Exception:
                pass
            self.backend = None

        event.accept()


# ----------------------------------------------------------------------
# Punto de entrada
# ----------------------------------------------------------------------
def main() -> None:
    rclpy.init(args=None)

    app = QtWidgets.QApplication(sys.argv)
    window = MainWindow()
    window.show()

    ret = app.exec_()

    # Por seguridad, aseguramos shutdown de ROS
    try:
        rclpy.shutdown()
    except Exception:
        pass

    sys.exit(ret)


if __name__ == "__main__":
    main()
