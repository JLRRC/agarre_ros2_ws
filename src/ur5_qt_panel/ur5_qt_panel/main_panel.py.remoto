#!/usr/bin/env python3
import os
import sys
import subprocess
from typing import Optional, Callable

from PyQt5.QtCore import Qt, QTimer, pyqtSignal
from PyQt5.QtGui import QImage, QPixmap
from PyQt5.QtWidgets import (
    QApplication,
    QMainWindow,
    QWidget,
    QVBoxLayout,
    QHBoxLayout,
    QGridLayout,
    QPushButton,
    QTextEdit,
    QTabWidget,
    QGroupBox,
    QMessageBox,
    QLabel,
    QSizePolicy,
    QComboBox,
)

# --- Integración ROS 2 + OpenCV (para mostrar imágenes) ---
ROS_AVAILABLE = False
try:
    import rclpy
    from rclpy.node import Node
    from sensor_msgs.msg import Image
    from cv_bridge import CvBridge
    import cv2

    ROS_AVAILABLE = True
except Exception as e:
    # Si falta algo, simplemente no habrá vista de cámara ROS
    print(f"[AVISO] ROS 2 / cv_bridge no disponible en el panel: {e}", file=sys.stderr)


class RealCamerasTab(QWidget):
    """
    Pestaña para gestionar las CÁMARAS REALES.
    Más adelante aquí conectaremos los comandos/scripts reales
    (por ejemplo lanzar nodos de cámaras físicas, etc.).
    """

    def __init__(self, run_cmd: Callable[[str, Optional[str]], None], parent=None):
        super().__init__(parent)
        self.run_cmd = run_cmd
        self._build_ui()

    def _build_ui(self):
        layout = QVBoxLayout()

        # Grupo de control de cámaras reales
        group_cameras = QGroupBox("Cámaras reales (hardware físico)")
        group_layout = QVBoxLayout()

        label_info = QLabel(
            "Esta pestaña está pensada para cuando tengas cámaras físicas.\n"
            "En el MELE, normalmente no las usarás, pero dejamos todo preparado."
        )
        label_info.setWordWrap(True)
        group_layout.addWidget(label_info)

        btn_start_real = QPushButton("Iniciar cámaras reales")
        btn_stop_real = QPushButton("Detener cámaras reales")

        btn_start_real.clicked.connect(self.start_real_cameras)
        btn_stop_real.clicked.connect(self.stop_real_cameras)

        group_layout.addWidget(btn_start_real)
        group_layout.addWidget(btn_stop_real)

        group_cameras.setLayout(group_layout)
        layout.addWidget(group_cameras)

        # Espacio para futuro: mostrar imágenes, estados, etc.
        placeholder = QLabel(
            "🔧 Aquí más adelante podremos añadir:\n"
            "- Vista de las imágenes de las cámaras físicas\n"
            "- Estado de los nodos ROS 2 de cámaras reales\n"
            "- Controles adicionales específicos"
        )
        placeholder.setAlignment(Qt.AlignTop | Qt.AlignLeft)
        placeholder.setWordWrap(True)
        layout.addWidget(placeholder)

        layout.addStretch()
        self.setLayout(layout)

    def start_real_cameras(self):
        # Aquí pondremos el comando real cuando toque
        self.run_cmd(
            "echo 'TODO: lanzar nodos de cámaras REALES (no configurado todavía)'",
            context="[Cámaras reales]",
        )

    def stop_real_cameras(self):
        # Aquí pondremos el comando real cuando toque
        self.run_cmd(
            "echo 'TODO: detener nodos de cámaras REALES (no configurado todavía)'",
            context="[Cámaras reales]",
        )


class SyntheticImagesTab(QWidget):
    """
    Pestaña para gestionar IMÁGENES SINTÉTICAS:
    - Lanzar Gazebo con ur5_mesa_objetos.sdf
    - Lanzar bridge ROS 2 <-> Gazebo
    - Comprobar tópicos de cámara
    Con columna lateral de estado (LEDs rojo/naranja/verde).
    """

    def __init__(self, run_cmd: Callable[[str, Optional[str]], None], parent=None):
        super().__init__(parent)
        self.run_cmd = run_cmd

        # Labels de estado (los definimos aquí para usarlos en todos los métodos)
        self.status_gazebo = QLabel()
        self.status_bridge = QLabel()
        self.status_cameras = QLabel()

        self._build_ui()

    # -------------------------
    # Utils de estado (LEDs)
    # -------------------------
    def _setup_led(self, label: QLabel, text: str):
        label.setFixedSize(18, 18)
        label.setAlignment(Qt.AlignCenter)
        label.setText("")  # solo círculo de color
        label.setToolTip(text)

    def _set_led_color(self, label: QLabel, state: str):
        """
        state: 'off' (rojo), 'on' (verde), 'warn' (naranja)
        """
        colors = {
            "off": "#cc0000",
            "on": "#00aa00",
            "warn": "#ff9900",
        }
        color = colors.get(state, "#cccccc")
        label.setStyleSheet(
            f"""
            border-radius: 9px;
            background-color: {color};
            border: 1px solid #555555;
            """
        )

    def _build_ui(self):
        # Layout horizontal principal: izquierda controles, derecha columna de estado
        main_hlayout = QHBoxLayout()

        # ==============================
        #  IZQUIERDA: CONTROLES
        # ==============================
        controls_layout = QVBoxLayout()

        # 1) Grupo Gazebo / UR5
        group_gazebo = QGroupBox("Simulación UR5 + Gazebo (imágenes sintéticas)")
        gazebo_layout = QVBoxLayout()

        label_info = QLabel(
            "Desde aquí lanzaremos todo el entorno SIMULADO:\n"
            "- Gazebo con el mundo ur5_mesa_objetos.sdf\n"
            "- Nodos ROS 2 asociados\n"
            "- Cámaras sintéticas (tópicos /camera/...)"
        )
        label_info.setWordWrap(True)
        gazebo_layout.addWidget(label_info)

        btn_launch_gazebo = QPushButton("Lanzar Gazebo (UR5 + mesa + objetos)")
        btn_stop_gazebo = QPushButton("Detener Gazebo")

        btn_launch_gazebo.clicked.connect(self.launch_gazebo_ur5_world)
        btn_stop_gazebo.clicked.connect(self.stop_gazebo)

        gazebo_layout.addWidget(btn_launch_gazebo)
        gazebo_layout.addWidget(btn_stop_gazebo)

        group_gazebo.setLayout(gazebo_layout)
        controls_layout.addWidget(group_gazebo)

        # 2) Grupo BRIDGE ROS 2 <-> Gazebo
        group_bridge = QGroupBox("Bridge ROS 2 ↔ Gazebo")
        bridge_layout = QVBoxLayout()

        label_bridge = QLabel(
            "El bridge conecta los tópicos internos de Gazebo con ROS 2.\n"
            "Hasta que no se lance, NO verás /camera/color/image_raw ni similares."
        )
        label_bridge.setWordWrap(True)
        bridge_layout.addWidget(label_bridge)

        btn_launch_bridge = QPushButton("Lanzar bridge ROS 2 ↔ Gazebo")
        btn_stop_bridge = QPushButton("Detener bridge")

        btn_launch_bridge.clicked.connect(self.launch_bridge)
        btn_stop_bridge.clicked.connect(self.stop_bridge)

        bridge_layout.addWidget(btn_launch_bridge)
        bridge_layout.addWidget(btn_stop_bridge)

        group_bridge.setLayout(bridge_layout)
        controls_layout.addWidget(group_bridge)

        # 3) Grupo cámaras sintéticas
        group_cameras = QGroupBox("Cámaras sintéticas (tópicos ROS 2)")
        cam_layout = QVBoxLayout()

        label_cam = QLabel(
            "Aquí podrás:\n"
            "- Comprobar los tópicos /camera/color/image_raw, /camera_overhead/image, etc.\n"
            "- Ver si el bridge está funcionando correctamente."
        )
        label_cam.setWordWrap(True)
        cam_layout.addWidget(label_cam)

        btn_check_topics = QPushButton("Comprobar tópicos de cámara")
        btn_check_topics.clicked.connect(self.check_camera_topics)
        cam_layout.addWidget(btn_check_topics)

        group_cameras.setLayout(cam_layout)
        controls_layout.addWidget(group_cameras)

        controls_layout.addStretch()

        # ==============================
        #  DERECHA: COLUMNA ESTADO
        # ==============================
        status_group = QGroupBox("Estado (imágenes sintéticas)")
        status_vlayout = QVBoxLayout()

        # Configuramos LEDs
        self._setup_led(self.status_gazebo, "Estado de Gazebo (UR5 + mundo)")
        self._setup_led(self.status_bridge, "Estado del bridge ROS 2 ↔ Gazebo")
        self._setup_led(self.status_cameras, "Estado de los tópicos de cámara")

        # Inicialmente todo rojo (apagado)
        self._set_led_color(self.status_gazebo, "off")
        self._set_led_color(self.status_bridge, "off")
        self._set_led_color(self.status_cameras, "off")

        # Fila Gazebo
        row_gazebo = QHBoxLayout()
        row_gazebo.addWidget(self.status_gazebo)
        row_gazebo.addSpacing(8)
        row_gazebo.addWidget(QLabel("Gazebo (UR5 + mundo)"))
        row_gazebo.addStretch()
        status_vlayout.addLayout(row_gazebo)

        # Fila Bridge
        row_bridge = QHBoxLayout()
        row_bridge.addWidget(self.status_bridge)
        row_bridge.addSpacing(8)
        row_bridge.addWidget(QLabel("Bridge ROS 2 ↔ Gazebo"))
        row_bridge.addStretch()
        status_vlayout.addLayout(row_bridge)

        # Fila Cámaras
        row_cams = QHBoxLayout()
        row_cams.addWidget(self.status_cameras)
        row_cams.addSpacing(8)
        row_cams.addWidget(QLabel("Tópicos de cámara"))
        row_cams.addStretch()
        status_vlayout.addLayout(row_cams)

        status_vlayout.addStretch()
        status_group.setLayout(status_vlayout)

        # Añadimos al layout principal
        main_hlayout.addLayout(controls_layout, stretch=3)
        main_hlayout.addWidget(status_group, stretch=1)

        self.setLayout(main_hlayout)

    # ========================================
    #   Acciones: Gazebo
    # ========================================
    def launch_gazebo_ur5_world(self):
        """
        Usamos tu script actual run_ur5_world.sh
        """
        # Naranja mientras lanza
        self._set_led_color(self.status_gazebo, "warn")
        cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/run_ur5_world.sh"
        self.run_cmd(cmd, context="[Sintéticas:Gazebo]")
        # Verde cuando termina el comando (asumimos OK)
        self._set_led_color(self.status_gazebo, "on")

    def stop_gazebo(self):
        """
        Parar Gazebo de forma sencilla.
        """
        cmd = "pkill -f 'gz sim' || echo 'Gazebo no estaba ejecutándose'"
        self.run_cmd(cmd, context="[Sintéticas:Gazebo]")
        # Rojo (apagado)
        self._set_led_color(self.status_gazebo, "off")

    # ========================================
    #   Acciones: BRIDGE ROS 2 <-> Gazebo
    # ========================================
    def launch_bridge(self):
        """
        Lanza el bridge ROS 2 ↔ Gazebo en BACKGROUND usando subprocess.Popen,
        para que no bloquee la interfaz Qt.
        """
        # LED naranja mientras lanzamos
        self._set_led_color(self.status_bridge, "warn")

        bash_cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/run_gz_ros_bridge.sh"

        try:
            # Lanzamos el bridge en segundo plano
            proc = subprocess.Popen(
                ["bash", "-lc", bash_cmd],
                stdout=open("/tmp/bridge_ros2_gz.log", "w"),
                stderr=subprocess.STDOUT,
            )

            msg = (
                f"Bridge ROS 2 ↔ Gazebo lanzado en background (PID={proc.pid}). "
                f"Log: /tmp/bridge_ros2_gz.log"
            )
            # Usamos el callback que nos pasó MainPanel
            self.run_cmd(f"echo '{msg}'", context="[Sintéticas:Bridge]")

            # LED verde (asumimos OK; si falla, se verá en el log)
            self._set_led_color(self.status_bridge, "on")

        except Exception as e:
            err_msg = f"ERROR al lanzar el bridge: {e}"
            self.run_cmd(f"echo '{err_msg}'", context="[Sintéticas:Bridge]")
            self._set_led_color(self.status_bridge, "off")

    def stop_bridge(self):
        """
        Mata el proceso del bridge (ros_gz_bridge).
        """
        cmd = "pkill -f 'ros_gz_bridge' || echo 'Bridge no estaba ejecutándose'"
        self.run_cmd(cmd, context="[Sintéticas:Bridge]")
        self._set_led_color(self.status_bridge, "off")

    # ========================================
    #   Acciones: cámaras (check tópicos)
    # ========================================
    def check_camera_topics(self):
        """
        Comprueba los tópicos de cámara en ROS 2.
        """
        self._set_led_color(self.status_cameras, "warn")
        cmd = (
            "cd ~/TFM/agarre_ros2_ws && "
            "source /opt/ros/jazzy/setup.bash && "
            "source install/setup.bash && "
            "ros2 topic list | grep camera || echo 'No hay tópicos /camera activos'"
        )
        self.run_cmd(cmd, context="[Sintéticas:Cámaras]")
        # De momento asumimos verde tras el check (si no hay tópicos, lo verás en el log)
        self._set_led_color(self.status_cameras, "on")


class ClickableLabel(QLabel):
    """
    QLabel que emite una señal (x, y) cuando se hace clic con el ratón.
    Lo usamos para seleccionar el objeto de agarre de forma manual.
    """

    clicked = pyqtSignal(int, int)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            x = event.pos().x()
            y = event.pos().y()
            self.clicked.emit(x, y)
        super().mousePressEvent(event)


class ControlTab(QWidget):
    """
    Pestaña de CONTROL:
    - Vista de cámara / robot (imágenes sintéticas).
    - Botoneras para mover el UR5.
    - Botoneras para lanzar experimentos de agarre.
    - Panel de estado (coordenadas del UR5 y del objeto).
    - Selección de objeto manual (ratón) o automática (IA).
    Integra suscripción ROS 2 a un tópico de cámara.
    """

    def __init__(self, run_cmd: Callable[[str, Optional[str]], None], parent=None):
        super().__init__(parent)
        self.run_cmd = run_cmd

        # Objetos ROS para la cámara (solo si ROS_AVAILABLE)
        self.ros_node: Optional[Node] = None
        self.bridge: Optional[CvBridge] = None
        self.image_sub = None
        self.image_timer: Optional[QTimer] = None
        self.current_camera_topic: Optional[str] = None

        if ROS_AVAILABLE:
            try:
                if not rclpy.ok():
                    rclpy.init(args=None)
            except Exception:
                try:
                    rclpy.init(args=None)
                except Exception:
                    pass

            try:
                if rclpy.ok():
                    self.ros_node = rclpy.create_node("qt_control_panel")
                    self.bridge = CvBridge()
                    self.image_timer = QTimer(self)
                    self.image_timer.timeout.connect(self._spin_ros_once)
                    self.image_timer.start(50)  # ~20 Hz
            except Exception as e:
                print(f"[AVISO] No se pudo crear el nodo ROS del panel: {e}", file=sys.stderr)
                self.ros_node = None
                self.bridge = None
                self.image_timer = None

        # Estado textual
        self.lbl_robot_pose: Optional[QLabel] = None
        self.lbl_camera_pose: Optional[QLabel] = None
        self.lbl_obj_px: Optional[QLabel] = None
        self.lbl_obj_world: Optional[QLabel] = None
        self.lbl_selection_mode: Optional[QLabel] = None
        self.combo_selection_mode: Optional[QComboBox] = None

        self._build_ui()

    # -----------------------------
    # Construcción de la interfaz
    # -----------------------------
    def _build_ui(self):
        layout = QHBoxLayout()

        # ==============================
        # IZQUIERDA: VISTA CÁMARA / ROBOT
        # ==============================
        view_group = QGroupBox("Vista de cámara / robot (imágenes sintéticas)")
        view_layout = QVBoxLayout()

        self.image_placeholder = ClickableLabel(
            "Aquí se mostrará la imagen de la cámara\n"
            "(por ejemplo /camera_overhead/image).\n\n"
            "Puedes hacer clic para seleccionar un objeto\n"
            "en modo MANUAL."
        )
        self.image_placeholder.setAlignment(Qt.AlignCenter)
        self.image_placeholder.setStyleSheet(
            "background-color: #000000; color: #ffffff; border: 1px solid #444444;"
        )
        self.image_placeholder.setMinimumSize(640, 480)
        # Conectar clic
        self.image_placeholder.clicked.connect(self._on_image_clicked)

        view_layout.addWidget(self.image_placeholder)

        # Selector de cámara + botón conectar
        cam_sel_layout = QHBoxLayout()
        cam_sel_layout.addWidget(QLabel("Tópico de cámara:"))

        self.combo_camera = QComboBox()
        self.combo_camera.addItem("/camera_overhead/image")
        self.combo_camera.addItem("/camera_lateral/image")
        cam_sel_layout.addWidget(self.combo_camera)

        btn_connect_cam = QPushButton("Conectar cámara")
        btn_connect_cam.clicked.connect(self._on_connect_camera)
        cam_sel_layout.addWidget(btn_connect_cam)

        cam_sel_layout.addStretch()
        view_layout.addLayout(cam_sel_layout)

        view_group.setLayout(view_layout)

        # ==============================
        # DERECHA: CONTROLES
        # ==============================
        right_layout = QVBoxLayout()

        # ---- Control del brazo UR5 ----
        arm_group = QGroupBox("Control del brazo UR5")
        arm_layout = QVBoxLayout()

        btn_home = QPushButton("Ir a posición inicial")
        btn_test_pose = QPushButton("Ir a posición de prueba")
        btn_open_gripper = QPushButton("Abrir gripper")
        btn_close_gripper = QPushButton("Cerrar gripper")

        btn_home.clicked.connect(self.go_home_pose)
        btn_test_pose.clicked.connect(self.go_test_pose)
        btn_open_gripper.clicked.connect(self.open_gripper)
        btn_close_gripper.clicked.connect(self.close_gripper)

        arm_layout.addWidget(btn_home)
        arm_layout.addWidget(btn_test_pose)
        arm_layout.addWidget(btn_open_gripper)
        arm_layout.addWidget(btn_close_gripper)

        arm_group.setLayout(arm_layout)

        # ---- Experimentos de agarre ----
        exp_group = QGroupBox("Experimentos de agarre")
        exp_layout = QVBoxLayout()

        btn_run_rgb = QPushButton("Lanzar experimento RGB")
        btn_run_rgbd = QPushButton("Lanzar experimento RGB-D")
        btn_eval_last = QPushButton("Evaluar último experimento")

        btn_run_rgb.clicked.connect(self.run_experiment_rgb)
        btn_run_rgbd.clicked.connect(self.run_experiment_rgbd)
        btn_eval_last.clicked.connect(self.eval_last_experiment)

        exp_layout.addWidget(btn_run_rgb)
        exp_layout.addWidget(btn_run_rgbd)
        exp_layout.addWidget(btn_eval_last)

        # Modo de selección de objeto
        exp_layout.addSpacing(8)
        exp_layout.addWidget(QLabel("Modo selección de objeto:"))
        self.combo_selection_mode = QComboBox()
        self.combo_selection_mode.addItem("Manual (ratón)")
        self.combo_selection_mode.addItem("Automática (IA)")
        self.combo_selection_mode.currentIndexChanged.connect(
            self._on_selection_mode_changed
        )
        exp_layout.addWidget(self.combo_selection_mode)

        exp_group.setLayout(exp_layout)

        # ---- Panel de estado (coordenadas) ----
        state_group = QGroupBox("Estado actual")
        state_layout = QGridLayout()

        # Fila UR5
        state_layout.addWidget(QLabel("UR5 (TCP en mundo):"), 0, 0)
        self.lbl_robot_pose = QLabel(
            "HOME  [coordenadas reales pendientes de integrar con ROS 2]"
        )
        state_layout.addWidget(self.lbl_robot_pose, 0, 1)

        # Fila cámara
        state_layout.addWidget(QLabel("Cámara (mundo):"), 1, 0)
        self.lbl_camera_pose = QLabel(
            "(-0.35, 0.0, 1.4, 0, -1.57, 0)  "
            "[leído del SDF, pendiente de integrar de forma automática]"
        )
        state_layout.addWidget(self.lbl_camera_pose, 1, 1)

        # Fila objeto en píxeles
        state_layout.addWidget(QLabel("Objeto (px en imagen):"), 2, 0)
        self.lbl_obj_px = QLabel("no seleccionado")
        state_layout.addWidget(self.lbl_obj_px, 2, 1)

        # Fila objeto en mundo/agarre
        state_layout.addWidget(QLabel("Objeto (agarre en mundo):"), 3, 0)
        self.lbl_obj_world = QLabel("no calculado")
        state_layout.addWidget(self.lbl_obj_world, 3, 1)

        # Fila modo selección
        state_layout.addWidget(QLabel("Selección:"), 4, 0)
        self.lbl_selection_mode = QLabel("Manual (clic en la imagen)")
        state_layout.addWidget(self.lbl_selection_mode, 4, 1)

        state_group.setLayout(state_layout)

        right_layout.addWidget(arm_group)
        right_layout.addWidget(exp_group)
        right_layout.addWidget(state_group)
        right_layout.addStretch()

        # Montamos layout principal
        layout.addWidget(view_group, stretch=3)
        layout.addLayout(right_layout, stretch=2)

        self.setLayout(layout)

    # -----------------------------
    # ROS 2: gestión cámara
    # -----------------------------
    def _spin_ros_once(self):
        """Hace avanzar el executor de rclpy para recibir mensajes."""
        if self.ros_node is not None and ROS_AVAILABLE:
            try:
                rclpy.spin_once(self.ros_node, timeout_sec=0.0)
            except Exception as e:
                print(f"[AVISO] Error en spin_once: {e}", file=sys.stderr)

    def _on_connect_camera(self):
        """Handler del botón 'Conectar cámara'."""
        topic = self.combo_camera.currentText().strip()
        if not ROS_AVAILABLE or self.ros_node is None or self.bridge is None:
            self.run_cmd(
                "echo 'ROS 2 / cv_bridge no están disponibles en este panel (revisa instalación)'",
                context="[Control:Cámara]",
            )
            return

        # Si ya teníamos una suscripción, la destruimos
        if self.image_sub is not None:
            try:
                self.ros_node.destroy_subscription(self.image_sub)
            except Exception:
                pass
            self.image_sub = None

        # Creamos nueva suscripción
        try:
            self.image_sub = self.ros_node.create_subscription(
                Image,
                topic,
                self._image_callback,
                10,
            )
            self.current_camera_topic = topic
            self.run_cmd(
                f"echo 'Conectado al tópico de cámara: {topic}'",
                context="[Control:Cámara]",
            )
        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR al suscribirse al tópico {topic}: {e}'",
                context="[Control:Cámara]",
            )

    def _image_callback(self, msg: Image):
        """Callback de la imagen: convierte a QImage y la pinta en el QLabel."""
        if not ROS_AVAILABLE or self.bridge is None:
            return
        try:
            # Convertir mensaje ROS a imagen OpenCV (BGR) y luego a RGB
            cv_img = self.bridge.imgmsg_to_cv2(msg, desired_encoding="bgr8")
            cv_img = cv2.cvtColor(cv_img, cv2.COLOR_BGR2RGB)

            h, w, ch = cv_img.shape

            # Log de depuración para ver que llegan frames
            self.run_cmd(
                f"echo 'Frame de cámara recibido: {w}x{h}'",
                context="[Control:Cámara]",
            )

            bytes_per_line = ch * w
            qimg = QImage(cv_img.data, w, h, bytes_per_line, QImage.Format_RGB888)
            # Copia para que no dependa del buffer original
            qimg = qimg.copy()

            pix = QPixmap.fromImage(qimg)
            pix = pix.scaled(
                self.image_placeholder.width(),
                self.image_placeholder.height(),
                Qt.KeepAspectRatio,
                Qt.SmoothTransformation,
            )

            # Limpiar texto inicial si aún está puesto
            if self.image_placeholder.text():
                self.image_placeholder.setText("")

            self.image_placeholder.setPixmap(pix)

        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR procesando imagen de cámara: {e}'",
                context="[Control:Cámara]",
            )

    # -----------------------------
    # Clic sobre la imagen (selección manual)
    # -----------------------------
    def _on_image_clicked(self, x: int, y: int):
        mode_text = (
            self.combo_selection_mode.currentText()
            if self.combo_selection_mode
            else "Manual"
        )
        if "Manual" in mode_text:
            msg = f"Selección manual en píxeles: ({x}, {y})"
            self.run_cmd(f"echo '{msg}'", context="[Control:Objeto]")
            # De momento mostramos coordenadas en píxeles, luego las mapearemos a mundo / grasp
            if self.lbl_obj_px:
                self.lbl_obj_px.setText(
                    f"({x}, {y})  [pendiente transformación a coordenadas de agarre]"
                )
        else:
            self.run_cmd(
                "echo 'Click ignorado: modo Automática (IA)'",
                context="[Control:Objeto]",
            )

    # -----------------------------
    # Cambio de modo de selección
    # -----------------------------
    def _on_selection_mode_changed(self, index: int):
        if not self.lbl_selection_mode or not self.combo_selection_mode:
            return
        text = self.combo_selection_mode.currentText()
        if "Manual" in text:
            self.lbl_selection_mode.setText("Manual (clic en la imagen)")
        else:
            self.lbl_selection_mode.setText("Automática (IA)")

    # -----------------------------
    # Helpers para texto de estado
    # -----------------------------
    def _set_robot_pose_text(self, label: str):
        if self.lbl_robot_pose:
            self.lbl_robot_pose.setText(
                f"{label}  [coordenadas reales pendientes de integrar con ROS 2]"
            )

    # ==============================
    # ACCIONES: UR5 (comandos ROS2 reales, en background)
    # ==============================
    def go_home_pose(self):
        bash_cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/ur5_go_home.sh"
        try:
            subprocess.Popen(["bash", "-lc", bash_cmd])
            self.run_cmd("echo 'Comando enviado: UR5 → HOME'", context="[Control:UR5]")
            self._set_robot_pose_text("UR5: posición HOME")
        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR al mover UR5 HOME: {e}'", context="[Control:UR5]"
            )

    def go_test_pose(self):
        bash_cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/ur5_go_test_pose.sh"
        try:
            subprocess.Popen(["bash", "-lc", bash_cmd])
            self.run_cmd(
                "echo 'Comando enviado: UR5 → POSICIÓN DE PRUEBA'",
                context="[Control:UR5]",
            )
            self._set_robot_pose_text("UR5: posición de PRUEBA")
        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR al mover UR5 a prueba: {e}'", context="[Control:UR5]"
            )

    def open_gripper(self):
        bash_cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/ur5_open_gripper.sh"
        try:
            subprocess.Popen(["bash", "-lc", bash_cmd])
            self.run_cmd(
                "echo 'Comando enviado: abrir gripper'", context="[Control:UR5]"
            )
        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR al abrir gripper: {e}'", context="[Control:UR5]"
            )

    def close_gripper(self):
        bash_cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/ur5_close_gripper.sh"
        try:
            subprocess.Popen(["bash", "-lc", bash_cmd])
            self.run_cmd(
                "echo 'Comando enviado: cerrar gripper'", context="[Control:UR5]"
            )
        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR al cerrar gripper: {e}'", context="[Control:UR5]"
            )

    # ==============================
    # ACCIONES: EXPERIMENTOS (en background)
    # ==============================
    def run_experiment_rgb(self):
        bash_cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/run_experiment_rgb.sh"
        try:
            subprocess.Popen(["bash", "-lc", bash_cmd])
            self.run_cmd(
                "echo 'Experimento RGB lanzado en background'",
                context="[Control:ExpRGB]",
            )
        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR al lanzar experimento RGB: {e}'",
                context="[Control:ExpRGB]",
            )

    def run_experiment_rgbd(self):
        bash_cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/run_experiment_rgbd.sh"
        try:
            subprocess.Popen(["bash", "-lc", bash_cmd])
            self.run_cmd(
                "echo 'Experimento RGB-D lanzado en background'",
                context="[Control:ExpRGBD]",
            )
        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR al lanzar experimento RGB-D: {e}'",
                context="[Control:ExpRGBD]",
            )

    def eval_last_experiment(self):
        bash_cmd = "cd ~/TFM/agarre_ros2_ws && ./scripts/eval_last_experiment.sh"
        try:
            subprocess.Popen(["bash", "-lc", bash_cmd])
            self.run_cmd(
                "echo 'Evaluación del último experimento lanzada en background'",
                context="[Control:ExpEval]",
            )
        except Exception as e:
            self.run_cmd(
                f"echo 'ERROR al evaluar último experimento: {e}'",
                context="[Control:ExpEval]",
            )


class MainPanel(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Panel de control – Agarre inteligente (ROS 2 + Gazebo)")
        self.resize(1100, 700)

        # Widget central
        central = QWidget()
        main_layout = QVBoxLayout()

        # Log compartido
        self.log = QTextEdit()
        self.log.setReadOnly(True)
        self.log.setLineWrapMode(QTextEdit.NoWrap)
        self.log.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        # ==============================
        # 1) Pestañas de CONFIGURACIÓN
        # ==============================
        self.config_tabs = QTabWidget()
        self.config_tabs.setTabPosition(QTabWidget.North)
        self.config_tabs.setMovable(False)

        self.real_cameras_tab = RealCamerasTab(run_cmd=self.run_command)
        self.synthetic_tab = SyntheticImagesTab(run_cmd=self.run_command)

        self.config_tabs.addTab(self.real_cameras_tab, "Cámaras reales")
        self.config_tabs.addTab(self.synthetic_tab, "Imágenes sintéticas")

        config_container = QWidget()
        config_layout = QVBoxLayout()
        config_layout.addWidget(self.config_tabs)
        config_container.setLayout(config_layout)

        # ==============================
        # 2) Pestaña de CONTROL
        # ==============================
        self.control_tab = ControlTab(run_cmd=self.run_command)

        # ==============================
        # 3) Tabs principales (menú de vistas)
        # ==============================
        self.main_tabs = QTabWidget()
        self.main_tabs.setTabPosition(QTabWidget.North)
        self.main_tabs.setMovable(False)

        self.main_tabs.addTab(config_container, "Configuración")
        self.main_tabs.addTab(self.control_tab, "Control y experimentos")

        # Botón de cerrar panel con confirmación
        bottom_layout = QHBoxLayout()
        bottom_layout.addStretch()
        btn_close = QPushButton("Cerrar panel")
        btn_close.clicked.connect(self.confirm_close)
        bottom_layout.addWidget(btn_close)

        # Montar todo
        main_layout.addWidget(self.main_tabs)
        main_layout.addWidget(QLabel("Salida / Log de comandos:"))
        main_layout.addWidget(self.log)
        main_layout.addLayout(bottom_layout)

        central.setLayout(main_layout)
        self.setCentralWidget(central)

    # ---------------------
    # Gestión de comandos
    # ---------------------
    def run_command(self, command: str, context: Optional[str] = None):
        """
        Ejecuta un comando en bash y vuelca stdout/stderr al log.
        De momento es bloqueante y sencillo. Más adelante lo podemos
        pasar a un hilo si hace falta.
        """
        prefix = f"{context} " if context else ""
        self.append_log(f"{prefix}$ {command}")

        try:
            completed = subprocess.run(
                ["bash", "-lc", command],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                check=False,
            )
            if completed.stdout:
                self.append_log(completed.stdout)
        except Exception as e:
            self.append_log(f"[ERROR] {e}")

    def append_log(self, text: str):
        self.log.append(text)
        # Scroll hasta el final
        self.log.moveCursor(self.log.textCursor().End)

    # ---------------------
    # Cerrar con confirmación
    # ---------------------
    def confirm_close(self):
        reply = QMessageBox.question(
            self,
            "Cerrar panel",
            "¿Seguro que quieres cerrar el panel?\n"
            "Se cerrará la interfaz, pero los procesos que ya estén lanzados "
            "seguirán ejecutándose salvo que los detengas explícitamente.",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )
        if reply == QMessageBox.Yes:
            QApplication.instance().quit()

    def closeEvent(self, event):
        """
        Si el usuario cierra con la X de la ventana, pedimos también confirmación.
        """
        reply = QMessageBox.question(
            self,
            "Cerrar panel",
            "¿Seguro que quieres cerrar el panel?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )
        if reply == QMessageBox.Yes:
            event.accept()
        else:
            event.ignore()


def main():
    # Aseguramos que QT use X11 en caso de problemas con Wayland (opcional)
    os.environ.setdefault("QT_QPA_PLATFORM", "xcb")

    app = QApplication(sys.argv)
    window = MainPanel()
    window.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
