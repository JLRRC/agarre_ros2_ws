<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="mesa_agarre_rgbd">

    <!-- Configuración básica del mundo -->
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Luz y plano de suelo -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- MESA (una caja estática elevada) -->
    <model name="mesa">
      <static>true</static>
      <!-- centro de la mesa en (0,0,0.75) aprox -->
      <pose>0 0 0.75 0 0 0</pose>
      <link name="mesa_link">
        <collision name="mesa_collision">
          <geometry>
            <!-- 1.2 m x 0.8 m x 0.05 m -->
            <box>
              <size>1.2 0.8 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="mesa_visual">
          <geometry>
            <box>
              <size>1.2 0.8 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- OBJETOS "DESORDENADOS" SOBRE LA MESA (entorno no estructurado) -->

    <!-- Caja 1 -->
    <model name="obj_box_1">
      <static>false</static>
      <pose>0.10 0.10 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.2 0.6 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Caja 2 -->
    <model name="obj_box_2">
      <static>false</static>
      <pose>-0.15 -0.10 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 0.06 0.06</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 0.06 0.06</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cilindro 1 -->
    <model name="obj_cyl_1">
      <static>false</static>
      <pose>0.05 -0.20 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.3 0.8 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cilindro 2 -->
    <model name="obj_cyl_2">
      <static>false</static>
      <pose>-0.25 0.05 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.9 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- BRAZO UR5 (ajusta este include a tu modelo real) -->
    <include>
      <!-- Si tienes el modelo UR5 en Fuel o en tus modelos locales -->
      <uri>model://ur5</uri>
      <name>ur5</name>
      <!-- Colocado a un lateral de la mesa -->
      <pose>-0.6 0 0 0 0 0</pose>
    </include>

    <!-- CÁMARA RGB-D 1: Vista cenital/oblicua desde arriba -->
    <!-- Imagina que está como una cámara montada en el techo, mirando hacia la mesa -->
    <model name="rgbd_cam_1">
      <static>true</static>
      <!-- x y z roll pitch yaw -->
      <!-- Un poco por encima y desplazada, mirando hacia el centro de la mesa -->
      <pose>0.6 0 1.3 0 -1.0 -1.57</pose>
      <link name="link">
        <sensor name="rgbd_sensor_1" type="rgbd_camera">
          <update_rate>15.0</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>

          <camera>
            <horizontal_fov>1.047</horizontal_fov> <!-- 60 grados aprox -->
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </camera>

          <depth_camera>
            <image>
              <width>640</width>
              <height>480</height>
              <format>FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </sensor>
      </link>
    </model>

    <!-- CÁMARA RGB-D 2: Vista lateral, viendo bien el agarre del efector final -->
    <model name="rgbd_cam_2">
      <static>true</static>
      <!-- Colocada a un lado de la mesa, un poco elevada, mirando hacia el robot -->
      <pose>0 -1.2 0.9 0 -0.3 0</pose>
      <link name="link">
        <sensor name="rgbd_sensor_2" type="rgbd_camera">
          <update_rate>15.0</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>

          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </camera>

          <depth_camera>
            <image>
              <width>640</width>
              <height>480</height>
              <format>FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>

