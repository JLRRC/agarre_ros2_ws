<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="mesa_agarre_rgbd">

    <gravity>0 0 -9.81</gravity>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Mesa -->
    <model name="mesa">
      <static>true</static>
      <pose>0 0 0.75 0 0 0</pose>
      <link name="mesa_link">
        <collision name="mesa_collision">
          <geometry>
            <box>
              <size>1.2 0.8 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="mesa_visual">
          <geometry>
            <box>
              <size>1.2 0.8 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.6 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Objetos sobre la mesa -->
    <model name="obj_box_1">
      <static>false</static>
      <pose>0.10 0.10 0.80 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass></inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.08 0.08 0.08</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.08 0.08 0.08</size></box>
          </geometry>
          <material>
            <diffuse>0.2 0.6 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obj_box_2">
      <static>false</static>
      <pose>-0.15 -0.10 0.80 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass></inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.10 0.06 0.06</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.10 0.06 0.06</size></box>
          </geometry>
          <material>
            <diffuse>0.8 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obj_cyl_1">
      <static>false</static>
      <pose>0.05 -0.20 0.80 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.15</mass></inertial>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.03</radius><length>0.10</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.03</radius><length>0.10</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.3 0.8 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

