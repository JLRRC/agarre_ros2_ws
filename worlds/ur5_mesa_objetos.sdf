<?xml version="1.0" ?>
<!-- URL: /home/laboratorio/TFM/agarre_ros2_ws/worlds/ur5_mesa_objetos.sdf -->
<!-- Summary: Gazebo world with UR5, table, objects, and cameras (pro). -->
<sdf version="1.10">
  <world name="ur5_mesa_objetos">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Plugin PosePublisher eliminado de <world> y movido al modelo ur5_rg2 -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.95 0.95 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Luz sin colisión con GUI -->
    <light name="sun_world" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Suelo -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
      <plugin
        filename="gz-sim-pose-publisher-system"
        name="gz::sim::systems::PosePublisher">
        <publish_pose>true</publish_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <static_publisher>false</static_publisher>
      </plugin>
    </model>

    <!-- ======================================================
         MESA PRINCIPAL (AGARRE) — centro (-0.17,0)
         ====================================================== -->
    <model name="mesa_pro">
      <static>true</static>
      <pose>-0.17 0 0 0 0 0</pose>
      <link name="link">

        <collision name="tablero_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>0.768 0.80 0.05</size></box></geometry>
        </collision>
        <visual name="tablero_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>0.768 0.80 0.05</size></box></geometry>
          <material><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>

        <!-- Bordes: pared alta (20 cm) en el extremo alejado del brazo + bordes bajos (2 cm) en los otros lados -->
        <!-- Mesa: size 0.768 x 0.80 x 0.05, top_z=0.775 -->
        <collision name="wall_far_x_pos_c">
          <pose>0.374 0 0.875 0 0 0</pose>
          <geometry><box><size>0.02 0.76 0.20</size></box></geometry>
        </collision>
        <visual name="wall_far_x_pos_v">
          <pose>0.374 0 0.875 0 0 0</pose>
          <geometry><box><size>0.02 0.76 0.20</size></box></geometry>
          <material><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>

        <collision name="wall_near_x_neg_c">
          <pose>-0.374 0 0.785 0 0 0</pose>
          <geometry><box><size>0.02 0.76 0.02</size></box></geometry>
        </collision>
        <visual name="wall_near_x_neg_v">
          <pose>-0.374 0 0.785 0 0 0</pose>
          <geometry><box><size>0.02 0.76 0.02</size></box></geometry>
          <material><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>

        <collision name="wall_north_c">
          <pose>0 0.39 0.785 0 0 0</pose>
          <geometry><box><size>0.728 0.02 0.02</size></box></geometry>
        </collision>
        <visual name="wall_north_v">
          <pose>0 0.39 0.785 0 0 0</pose>
          <geometry><box><size>0.728 0.02 0.02</size></box></geometry>
          <material><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>

        <collision name="wall_south_c">
          <pose>0 -0.39 0.785 0 0 0</pose>
          <geometry><box><size>0.728 0.02 0.02</size></box></geometry>
        </collision>
        <visual name="wall_south_v">
          <pose>0 -0.39 0.785 0 0 0</pose>
          <geometry><box><size>0.728 0.02 0.02</size></box></geometry>
          <material><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>

        <!-- patas -->
        <collision name="p1c"><pose> 0.334  0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual    name="p1v"><pose> 0.334  0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>

        <collision name="p2c"><pose> 0.334 -0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual    name="p2v"><pose> 0.334 -0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>

        <collision name="p3c"><pose>-0.334  0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual    name="p3v"><pose>-0.334  0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>

        <collision name="p4c"><pose>-0.334 -0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual    name="p4v"><pose>-0.334 -0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>

      </link>
    </model>

    <!-- Objetos sobre mesa principal -->
    <model name="cubo_rojo">
      <static>false</static>
      <pose>-0.02 0.10 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><diffuse>0.90 0.10 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cilindro_verde">
      <static>false</static>
      <pose>-0.27 0.05 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.06</mass>
          <inertia>
            <ixx>0.00015</ixx><iyy>0.00015</iyy><izz>0.00015</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.07</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.07</length></cylinder></geometry><material><diffuse>0.10 0.85 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <model name="caja_azul">
      <static>false</static>
      <pose>-0.17 -0.15 0.80 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.10</mass>
          <inertia>
            <ixx>0.00025</ixx><iyy>0.00025</iyy><izz>0.00025</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.10 0.06 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 0.06 0.04</size></box></geometry><material><diffuse>0.10 0.25 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <!-- PIEZA DINÁMICA en la mesa principal (para agarrar) -->
    <model name="pieza_pick_mesa">
      <static>false</static>
      <pose>-0.42 0.00 0.81 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.05</length></cylinder></geometry><material><diffuse>0.20 0.20 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ======================================================
         MESA ROBOT (PEQUEÑA) — ALINEADA con mesa principal
         - centro x = -1.10, y = 0.00  (alineada en Y)
         - borde cercano aprox: x = -0.75, mesa principal borde: x = -0.75 -> gap ~0
         ====================================================== -->
    <model name="mesa_robot">
      <static>true</static>
      <pose>-1.10 0.00 0 0 0 0</pose>
      <link name="link">

        <collision name="tablero_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>0.70 0.50 0.05</size></box></geometry>
        </collision>
        <visual name="tablero_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>0.70 0.50 0.05</size></box></geometry>
          <material><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>

        <!-- patas -->
        <collision name="p1"><pose> 0.30  0.20 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual    name="p1v"><pose> 0.30  0.20 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry><material><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>

        <collision name="p2"><pose> 0.30 -0.20 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual    name="p2v"><pose> 0.30 -0.20 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry><material><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>

        <collision name="p3"><pose>-0.30  0.20 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual    name="p3v"><pose>-0.30  0.20 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry><material><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>

        <collision name="p4"><pose>-0.30 -0.20 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual    name="p4v"><pose>-0.30 -0.20 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry><material><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>

        <!-- PAD (zona depósito) cerca del borde hacia mesa principal -->
</link>
    </model>
    <!-- BANDEJA (depósito) - vacía al inicio -->
    <model name="bandeja_deposito">
      <static>true</static>
      <!-- mesa_robot top = 0.775; base de bandeja (0.01) => centro a 0.780 -->
      <!-- colocada en el lado izquierdo de la mesa_robot (donde estaba el robot aprox) -->
      <pose>-1.30 0.00 0.780 0 0 0</pose>
      <link name="link">
        <!-- base -->
        <collision name="base_c">
          <geometry><box><size>0.28 0.22 0.01</size></box></geometry>
        </collision>
        <visual name="base_v">
          <geometry><box><size>0.28 0.22 0.01</size></box></geometry>
          <material><diffuse>0.95 0.85 0.20 1</diffuse></material>
        </visual>

        <!-- paredes (altura ~0.07, grosor 0.01) -->
        <collision name="wall_n_c">
          <pose>0 0.105 0.035 0 0 0</pose>
          <geometry><box><size>0.28 0.01 0.07</size></box></geometry>
        </collision>
        <visual name="wall_n_v">
          <pose>0 0.105 0.035 0 0 0</pose>
          <geometry><box><size>0.28 0.01 0.07</size></box></geometry>
          <material><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>

        <collision name="wall_s_c">
          <pose>0 -0.105 0.035 0 0 0</pose>
          <geometry><box><size>0.28 0.01 0.07</size></box></geometry>
        </collision>
        <visual name="wall_s_v">
          <pose>0 -0.105 0.035 0 0 0</pose>
          <geometry><box><size>0.28 0.01 0.07</size></box></geometry>
          <material><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>

        <collision name="wall_e_c">
          <pose>0.135 0 0.035 0 0 0</pose>
          <geometry><box><size>0.01 0.22 0.07</size></box></geometry>
        </collision>
        <visual name="wall_e_v">
          <pose>0.135 0 0.035 0 0 0</pose>
          <geometry><box><size>0.01 0.22 0.07</size></box></geometry>
          <material><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>

        <collision name="wall_w_c">
          <pose>-0.135 0 0.035 0 0 0</pose>
          <geometry><box><size>0.01 0.22 0.07</size></box></geometry>
        </collision>
        <visual name="wall_w_v">
          <pose>-0.135 0 0.035 0 0 0</pose>
          <geometry><box><size>0.01 0.22 0.07</size></box></geometry>
          <material><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- PIEZA DINÁMICA sobre PAD (para depositar) -->
<!-- ======================================================
         BRAZO COMERCIAL: UR5 + RG2 (Universal Robots)
         - sobre mesa_robot
         - mirando hacia la mesa principal (yaw = 0)
         ====================================================== -->
    <include>
      <uri>model://ur5_rg2</uri>
      <name>ur5_rg2</name>
      <!-- mesa top: 0.775 -->
      <pose>-0.85 0.00 0.775 0 0 0</pose>
      <!-- Plugin PosePublisher eliminado: no disponible en el sistema -->
    </include>
    <joint name="ur5_rg2_fixed_to_world" type="fixed">
      <parent>world</parent>
      <child>ur5_rg2::base_link</child>
    </joint>

    <!-- ======================================================
         CAMARAS RGBD
         FIX REAL: el pitch estaba invertido. Ahora TODAS apuntan a la mesa.
         NOTA: En gz-sim la cámara mira por el eje +X del sensor.
         ====================================================== -->

    <!-- Overhead: inclinada desde la posicion del robot para ver la mesa completa -->
    <model name="camera_overhead">
      <static>true</static>
      <pose>-0.85 0.00 1.85 0 1.02 0</pose>
      <link name="link">
        <sensor name="camera_overhead_rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/camera_overhead/image</topic>
          <camera>
            <horizontal_fov>0.75</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
        <sensor name="camera_overhead_depth" type="depth_camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/camera_overhead/depth_image</topic>
          <camera>
            <horizontal_fov>0.75</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Postes en esquinas fuera de mesa -->
    <!-- yaw a (0,0): NW=-0.668, NE=-2.475, SE=+2.475, SW=+0.668 -->
    <!-- pitch = +1.05 (~60º) para mirar hacia abajo a la mesa -->

    <model name="camera_north">
      <static>true</static>
      <pose>-0.95 0.75 0 0 0 0</pose>
      <link name="link">
        <sensor name="camera_north_rgbd" type="rgbd_camera">
          <pose>0 0 2.90 0 1.05 -0.668</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/camera_north</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="camera_east">
      <static>true</static>
      <pose>0.95 0.75 0 0 0 0</pose>
      <link name="link">
        <sensor name="camera_east_rgbd" type="rgbd_camera">
          <pose>0 0 2.90 0 1.05 -2.475</pose>
          <always_on>true</always_on>
          <update_rate>60</update_rate>
          <topic>/camera_east</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="camera_south">
      <static>true</static>
      <pose>-2.00 0.00 0 0 0 0</pose>
      <link name="link">
        <sensor name="camera_south_rgbd" type="camera">
          <pose>0 0 2.10 0 0.75 0</pose>
          <always_on>true</always_on>
          <update_rate>60</update_rate>
          <topic>/camera_south/image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="camera_west">
      <static>true</static>
      <pose>1.30 0.00 0 0 0 0</pose>
      <link name="link">
        <sensor name="camera_west_rgbd" type="camera">
          <pose>0 0 2.00 0 0.85 3.1416</pose>
          <always_on>true</always_on>
          <update_rate>60</update_rate>
          <topic>/camera_west/image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- DROP_OBJECTS_BEGIN -->

