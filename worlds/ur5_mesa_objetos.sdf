        <kinematic>false</kinematic>
        <inertial><mass>0.11</mass><inertia><ixx>0.00014666666666666666</ixx><iyy>0.00014666666666666666</iyy><izz>2.9333333333333336e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.04 0.04 0.12</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.12</size></box></geometry><material><diffuse>0.20 0.80 0.20 1</diffuse></material></visual>
