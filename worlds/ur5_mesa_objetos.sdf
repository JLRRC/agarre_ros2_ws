    <model name="cyl_gray">
      <static>false</static>
      <pose>-0.170 0.040 1.925 0 0 0</pose>
      <link name="link">
        <gravity>true</gravity>
        <kinematic>false</kinematic>
        <inertial><mass>0.1</mass><inertia><ixx>0.00017333333333333336</ixx><iyy>0.00017333333333333336</iyy><izz>2e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.02</radius><length>0.14</length></cylinder></geometry></collision>
