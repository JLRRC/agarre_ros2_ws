<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="ur5_mesa_objetos">

    <!-- =========================
         Configuración general
         ========================= -->
    <gravity>0 0 -9.81</gravity>

    <!-- Luz tipo "sol" -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Suelo plano -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =========================
         UR5 con pinza RG2 (desde Fuel)
         ========================= -->
    <!--
      Modelo: ur5_rg2
      Fuente: https://fuel.ignitionrobotics.org/1.0/AndrejOrsula/models/ur5_rg2
      NOTA: requiere conexión a Internet la primera vez para descargar el modelo.
    -->
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/AndrejOrsula/models/ur5_rg2</uri>
      <name>ur5_rg2</name>
      <!-- Colocamos el UR5 a la izquierda de la mesa, sobre el suelo -->
      <!-- x y z R P Y -->
      <pose>-0.6 0.0 0.0 0 0 0</pose>
    </include>

    <!-- =========================
         Mesa de ensayo
         ========================= -->
    <!-- Mesa: 0.8 x 1.2 m, grosor 5 cm, altura aprox 0.75 m -->
    <model name="mesa">
      <static>true</static>
      <!-- x y z R P Y -->
      <pose>0 0 0.775 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 1.2 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 1.2 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Altura de la superficie de la mesa:
        z_centro_mesa = 0.775
        grosor/2 = 0.0

