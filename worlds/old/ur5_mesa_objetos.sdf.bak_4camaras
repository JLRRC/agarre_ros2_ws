<?xml version="1.0"?>
<sdf version="1.8">
  <world name="ur5_mesa_objetos">

    <!-- Gravedad global -->
    <gravity>0 0 -9.81</gravity>

    <!-- Sol direccional -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Plugins de sistemas de Gazebo (necesarios para sensores, etc.) -->
    <!-- Física -->
    <plugin
      name="gz::sim::systems::Physics"
      filename="gz-sim-physics-system">
      <engine>
        <type>bullet-featherstone</type>
      </engine>
    </plugin>

    <!-- Sensores (IMPRESCINDIBLE para que funcionen las cámaras) -->
    <plugin
      name="gz::sim::systems::Sensors"
      filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Broadcasting de escena (útil para GUIs/remotos) -->
    <plugin
      name="gz::sim::systems::SceneBroadcaster"
      filename="gz-sim-scene-broadcaster-system"/>

    <!-- Plano de suelo -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5 5</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tablero de la mesa -->
    <model name="mesa_tablero">
      <static>true</static>
      <!-- x y z R P Y (altura 0.75 m) -->
      <pose>0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Patas de la mesa -->
    <model name="mesa_pata1">
      <static>true</static>
      <pose>0.35 0.35 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="mesa_pata2">
      <static>true</static>
      <pose>0.35 -0.35 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="mesa_pata3">
      <static>true</static>
      <pose>-0.35 0.35 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="mesa_pata4">
      <static>true</static>
      <pose>-0.35 -0.35 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Objetos de agarre en la mesa -->
    <model name="cubo_rojo">
      <pose>0.20 0.00 0.80 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cilindro_verde">
      <pose>0.00 0.20 0.80 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="caja_azul">
      <pose>-0.15 -0.15 0.80 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.12 0.08 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.08 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- UR5 + RG2 desde Ignition Fuel -->
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/AndrejOrsula/models/ur5_rg2</uri>
      <name>ur5_rg2</name>
      <!-- Colocado al borde de la mesa -->
      <pose>-0.35 0.0 0.82 0 0 0</pose>
    </include>

    <!-- Cámara cenital sobre la mesa -->
    <model name="camera_overhead">
      <!-- x y z R P Y  -->
      <!-- La colocamos encima del UR5 (x=-0.35, y=0.0) a 1.4 m de altura, mirando hacia abajo -->
      <pose>-0.35 -0.55 1.4 0 -1.57 0</pose>
      <static>true</static>
      <link name="link">
        <sensor name="camera_overhead_sensor" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov> <!-- ~60 grados -->
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <!-- Topic de imagen en Gazebo (lo puenteamos a ROS2) -->
          <topic>/camera_overhead/image</topic>
        </sensor>
      </link>
    </model>

    <!-- Cámara lateral mirando a la zona de agarre -->
    <model name="camera_lateral">
      <!-- x y z R P Y: la rotamos pi radianes en yaw para mirar hacia la mesa -->
      <pose>0.7 0 0.4 0 0 3.14159</pose>
      <static>true</static>
      <link name="link">
        <sensor name="camera_lateral_sensor" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <!-- Usamos topic tipo "image_raw" para casar con el bridge -->
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <!-- IMPORTANTE: coincide con lo que usas en el bridge -->
          <topic>/camera/color/image_raw</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
