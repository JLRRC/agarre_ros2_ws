<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="ur5_mesa_objetos">

    <!-- =========================
         Configuración general
         ========================= -->
    <gravity>0 0 -9.81</gravity>

    <!-- Luz tipo "sol" -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Suelo plano -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =========================
         Mesa de ensayo
         ========================= -->
    <!-- Mesa: 0.8 x 1.2 m, grosor 5 cm, altura aprox 0.75 m -->
    <model name="mesa">
      <static>true</static>
      <!-- x y z R P Y -->
      <pose>0 0 0.775 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 1.2 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 1.2 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Altura de la superficie de la mesa:
        z_centro_mesa = 0.775
        grosor/2 = 0.025
        => z_superficie ≈ 0.800 m
      Por eso los objetos van con z = 0.80
    -->

    <!-- =========================
         Objetos de prueba
         ========================= -->

    <!-- Objeto 1: cubo rojo -->
    <model name="cubo_rojo">
      <!-- x y z R P Y -->
      <pose>0.20 0.00 0.80 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Objeto 2: cilindro verde -->
    <model name="cilindro_verde">
      <pose>0.00 0.20 0.80 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Objeto 3: caja azul tipo "libro" -->
    <model name="caja_azul">
      <pose>-0.15 -0.15 0.80 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.12 0.08 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.08 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      NOTA (para el TFM):
      El UR5 no se incluye directamente en este fichero SDF.
      Se lanza desde ROS 2 (paquete ur5_bringup) sobre este mundo,
      lo que permite desacoplar el modelo del robot del entorno de ensayo.
    -->

  </world>
</sdf>

